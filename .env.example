# Copy to .env and fill in. Never commit .env.

# A long random string, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# The hostnames/IPs Pursegraph is reached by on the LAN or VPN, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The local Ollama server that suggests Subcategories (LAN only, never a cloud service).
OLLAMA_URL=http://192.168.50.188:11434
# Port published on the host.
PURSEGRAPH_PORT=8000
# Host directory of the nightly database dumps (create it first), and the host user:group
# (from `id -u` and `id -g`) who owns them.
PURSEGRAPH_BACKUPS=./backups
PURSEGRAPH_BACKUP_USER=1000:1000
# Time zone and hour of the nightly dump.
BACKUP_TZ=Europe/Ljubljana
BACKUP_HOUR=3

POSTGRES_DB=pursegraph
POSTGRES_USER=pursegraph
POSTGRES_PASSWORD=
